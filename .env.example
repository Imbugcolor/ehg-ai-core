# Bản mẫu — chỉ có TÊN biến, không có giá trị thật.
# Copy thành .env rồi điền. File .env đã nằm trong .gitignore, không bao giờ commit.

# --- Supabase -----------------------------------------------------------------
# Personal access token cấp TÀI KHOẢN (sbp_...). Dùng cho CLI và chạy migration.
# Không đưa vào code chạy thật — nó truy cập được mọi project trong tài khoản.
ACCESS_TOKEN=

SUPABASE_PROJECT_REF=
SUPABASE_URL=

# Khoá công khai, dùng được ở phía trình duyệt. RLS vẫn áp dụng.
SUPABASE_ANON_KEY=

# Khoá này BỎ QUA TOÀN BỘ RLS. Chỉ dùng ở phía máy chủ, không bao giờ gửi ra client.
SUPABASE_SERVICE_ROLE_KEY=

# Mật khẩu database và chuỗi kết nối
DB_PASSWORD=
DATABASE_URL=
DATABASE_POOLER_URL=

# --- Model AI -----------------------------------------------------------------
OPEN_ROUTER_API_KEY=

# Ghi đè model nếu cần. Bỏ trống thì dùng mặc định trong modules/ai-core/env.mjs
EMBEDDING_MODEL=
EMBEDDING_DIM=
EMBEDDING_VERSION=
CHAT_MODEL=
RERANK_MODEL=
GUARD_MODEL=

# Ngưỡng tin cậy: dưới mức này thì trả "không đủ cơ sở", không gọi model chat
RAG_THRESHOLD=
